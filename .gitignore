/data/
/raw_totalseg/
/data_ct/
*.nii
*.nii.gz
*.dcm
*.dicom

# --- Environnement Python ---
.venv/
venv/
env/
ENV/
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
.Python
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Notebooks Jupyter ---
.ipynb_checkpoints/
*.ipynb-checkpoint
# Garder les notebooks au format propre (pas les sorties)
# Si vous voulez exclure carrement les notebooks : decommenter
# *.ipynb

